{
  "name": "pm-return-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv/bin/uvicorn api.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-android.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
